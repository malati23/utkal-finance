# ====================================================================
# Utkal Finance - Frontend Environment Variables Example
# Duplicate this file as `.env` for local development customization.
# ====================================================================

# Backend API Base URL (must end with /api or specify custom path)
VITE_API_URL=http://localhost:5000/api

# Backend Server Root URL (optional, defaults to VITE_API_URL without /api)
# VITE_SERVER_URL=http://localhost:5000

# Prototype Admin Credentials (for development / prototype authentication)
VITE_ADMIN_EMAIL=admin@newutkalfinance.com
VITE_ADMIN_PASSWORD=Admin@123
